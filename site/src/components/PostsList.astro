---
import type { Post } from '../lib/posts';
import ArticleDate from './ArticleDate.astro';

interface Props { posts: Post[]; }
const { posts } = Astro.props;
---

<div class="base-grid">
  <ol class="posts-list article-list listing-width l-page" role="list">
    {posts.map(report => (
      <li class="post-preview article-list-row">
        <div class="article-list-content">
          <a class="post-link" href={report.href}>
            <h2 class="title article-list-title">{report.data.title}</h2>
          </a>
          <div class="post-details">
            <span class="published-date"><ArticleDate date={report.data.updated_at} compact /></span>
          </div>
        </div>
      </li>
    ))}
  </ol>
</div>

<style>
  .post-preview { display: block; overflow: hidden; }
  .post-link { display: block; color: inherit; text-decoration: none; }
  .post-link:focus-visible { outline: 2px solid var(--accent); outline-offset: 6px; }
  .post-details { display: flex; align-items: center; flex-wrap: wrap; gap: .5em 1em; margin-top: calc(12px * var(--listing-scale)); font-size: calc(12px * var(--listing-scale)); line-height: 1.4; }
  .published-date { color: var(--listing-muted); }
</style>
