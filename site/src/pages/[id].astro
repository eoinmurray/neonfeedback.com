---
import { getEntry, render } from 'astro:content';
import { getPosts, type Article } from '../lib/posts';
import Report from '../layouts/Report.astro';
export async function getStaticPaths() {
  return (await getPosts({ includeArchive: true })).flatMap(post => {
    const paths = [{ params: { id: post.id }, props: { report: post.article, redirectTo: undefined as string | undefined } }];
    const filename = post.article.filePath?.split('/').pop()?.replace(/\.mdx?$/, '');
    if (filename && filename !== post.id) {
      paths.push({ params: { id: filename }, props: { report: post.article, redirectTo: post.href } });
    }
    return paths;
  });
}
interface Props { report: Article; redirectTo?: string; }
if (Astro.props.redirectTo) return Astro.redirect(Astro.props.redirectTo, 301);
const report = import.meta.env.DEV ? await getEntry(Astro.props.report.collection, Astro.params.id!) : Astro.props.report;
if (!report) throw new Error(`Missing article: ${Astro.params.id}`);
const { Content } = await render(report);
---
<Report report={report}><Content /></Report>
