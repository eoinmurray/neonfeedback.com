---
import { withBase } from '../lib/urls';
import 'katex/dist/katex.min.css';
import '../styles/article-list.css';
import ThemeHead from '../components/ThemeHead.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import FigureLightbox from '../components/FigureLightbox.astro';
import '../styles/theme.css';
import base from '../styles/distill/styles-base.css?raw';
import layout from '../styles/distill/styles-layout.css?raw';
import titleStyle from '../styles/distill/d-title.css?raw';
import byline from '../styles/distill/d-byline.css?raw';
import article from '../styles/distill/d-article.css?raw';
import appendix from '../styles/distill/d-appendix.css?raw';
import math from '../styles/distill/d-math.css?raw';
import print from '../styles/distill/styles-print.css?raw';

interface Props {
  title: string;
  description?: string;
  frontMatter?: Record<string, unknown>;
  compact?: boolean;
  noindex?: boolean;
}

const { title, description, frontMatter, compact = false, noindex = false } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const publicPath = basePath && Astro.url.pathname.startsWith(basePath + '/') ? Astro.url.pathname.slice(basePath.length) : Astro.url.pathname;
const canonicalPath = publicPath.replace(/\.html$/, '').replace(/\/+$/, '') || '/';
const canonicalUrl = new URL(canonicalPath, Astro.site);
const distillStyles = base + layout + titleStyle + byline + article + math + appendix + print;
const frontMatterJson = JSON.stringify(frontMatter ?? null).replaceAll('<', '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <ThemeHead />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <title>{title} · Neonfeedback</title>
    <style is:inline id="distill-prerendered-styles" set:html={distillStyles} />
    <script is:inline src={withBase('/vendor/distill/template.v2.js')}></script>
  </head>
  <body distill-prerendered>
    {frontMatter && <d-front-matter><script is:inline type="application/json" set:html={frontMatterJson} /></d-front-matter>}
    <header class:list={['site-header', 'base-grid', { compact }]}>
      <nav class:list={['l-page', { 'listing-width': compact }]} aria-label="Site">
        <a href={withBase('/')}>Neonfeedback</a>
        <div class="nav-links">
          <ThemeToggle />
        </div>
      </nav>
    </header>
    <main><slot /></main>
    <FigureLightbox />
    <script>import '../scripts/citations';</script>
  </body>
</html>

<style is:global>
  .citation-preview { position: fixed; z-index: 10; box-sizing: border-box; width: min(380px, calc(100vw - 24px)); max-height: 50vh; overflow-y: auto; padding: 1rem; border: 1px solid rgb(var(--ink) / .15); background: var(--popup); box-shadow: 0 4px 20px rgb(var(--ink) / .12); font-size: 13px; line-height: 1.6; color: rgb(var(--ink) / .8); }
  .citation-preview[hidden] { display: none; }
  .citation-preview a { color: inherit; }
  .site-header { padding: 1rem 0; }
  d-title { padding-top: 1rem; }
  @media (min-width: 768px) { d-title { padding-top: 2rem; } }
  .site-header a { color: inherit; font-weight: 600; text-decoration: none; }
  .site-header nav { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .site-header .nav-links { display: flex; align-items: center; gap: 1rem; }
  .metadata { font-size: .8rem; color: rgb(var(--ink) / .6); }
  .katex { font-size: 1.05em; }
  .katex-display { overflow-x: auto; overflow-y: hidden; padding: .5rem 0; }
  d-article { padding-bottom: 3rem; }
</style>
